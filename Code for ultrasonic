void connectToWiFi() {
  Serial.print("Connecting to WiFi: ");    // print connection attempt
  Serial.println(ssid);

  WiFi.mode(WIFI_STA);                     // set station mode (connect to router)
  WiFi.begin(ssid, password);              // begin WiFi connection

  while (WiFi.status() != WL_CONNECTED) {  // wait until connected
    Serial.print(".");
    delay(300);
  }

  Serial.println("\nWiFi CONNECTED");      // connected message
  Serial.print("IP: ");
  Serial.println(WiFi.localIP());          // print local IP address
}

bool connectToServer() {
  return client.connect(server, port);     // open TCP connection to server
}

// Ultrasonic distance read in millimeters
float readUltrasonicMM() {
  digitalWrite(trigPin, LOW);              // ensure trig low
  delayMicroseconds(2);                    // short settle
  digitalWrite(trigPin, HIGH);             // start trigger pulse
  delayMicroseconds(10);                   // 10us pulse width
  digitalWrite(trigPin, LOW);              // end trigger pulse

  // timeout prevents blocking forever (e.g., 25ms ≈ 4m range)
  unsigned long duration = pulseIn(echoPin, HIGH, 25000); // measure echo high time

  if (duration == 0) return -1;            // timeout/no echo

  float distance_mm = ((duration * 0.0343) / 2.0) * 10.0; // convert to mm
  return distance_mm;                       // return distance in mm
}

// Read full HTTP response with a timeout
String readResponseWithTimeout(uint32_t timeoutMs) {
  String resp;                              // response string
  unsigned long deadline = millis() + timeoutMs; // compute deadline time

  while (millis() < deadline) {
    while (client.available()) resp += (char)client.read(); // read available bytes
    if (!client.connected()) break;         // stop if disconnected
    delay(5);
  }
  return resp;                              // return response text
}

// Extract HTTP status code from response header line
int getStatusCode(String &response) {
  if (response.length() < 12) return 0;     // guard: too short
  return response.substring(9, 12).toInt(); // HTTP/1.1 ### ...
}

// Extract body text (after blank line) from HTTP response
String getResponseBody(String &response) {
  int split = response.indexOf("\r\n\r\n"); // find header/body separator
  if (split == -1) return "";               // no separator found
  String body = response.substring(split + 4); // body starts after separator
  body.trim();                              // remove whitespace
  return body;
}

// Notify server that robot arrived at a node, get next target node
int notifyArrival(int position) {
  if (!connectToServer()) return -1;        // return -1 if cannot connect

  String postBody = "position=" + String(position); // build POST body

  client.println("POST /api/arrived/" + String(teamID) + " HTTP/1.1"); // HTTP request line
  client.println("Host: " + String(server));                           // Host header
  client.println("Content-Type: application/x-www-form-urlencoded");   // Content type header
  client.print("Content-Length: ");                                    // content length label
  client.println(postBody.length());                                   // content length value
  client.println();                                                    // blank line ends headers
  client.println(postBody);                                            // POST body

  String response = readResponseWithTimeout(2500); // read response from server
  int statusCode = getStatusCode(response);        // parse status code
  client.stop();                                   // close connection

  if (statusCode != 200) return -1;                // server error if not 200 OK

  String body = getResponseBody(response);         // get response body
  if (body.equalsIgnoreCase("Finished")) return -2; // -2 means finished signal

  return body.toInt();                             // otherwise return next node ID
}
